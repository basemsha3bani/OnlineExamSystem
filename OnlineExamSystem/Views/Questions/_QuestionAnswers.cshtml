@model IEnumerable<DataModel.QuestionAnswersDataModel>

@{
    ViewData["Title"] = "_QuestionAnswers";
}

<h1>_uestion Answers</h1>


<table class="table">
    <thead>
        <tr>
            <th>
              
            </th>
            <th>
               
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AnswerText)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsCorrect)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@{int i=0;}
@foreach (var item in Model) {
            {
                <tr>
                    <td class="text-center">
                    <!-- Same name = only one can be checked -->
                    <input type="radio" name="CorrectAnswerIndex" value="@i"
                           @(item.IsCorrect ? "checked" : "") required />
                    @Html.HiddenFor(m => item.Id)
                    @Html.HiddenFor(m => item.QuestionId)
                </td>
                <td>
                    <input asp-for="@item.AnswerText" class="form-control" placeholder="Answer @(i + 1)" />
                    <span asp-validation-for="@item.AnswerText" class="text-danger"></span>
                </td>
            </tr>
                i++;
            }
}
    </tbody>
</table>
