@model List<Domain.DTOs.ExamSectionRulesDTO>
@{ var definition = (Domain.DTOs.ExamSectionsDTO)ViewBag.Section; var total = Model.Sum(r => r.NoOfQuestions); }
<h3>@definition.SectionName - Rules</h3>
<a asp-action="Create" asp-route-sectionId="@definition.Id" class="btn btn-primary">Add rule</a>
<table class="table"><thead><tr><th>Difficulty</th><th>Number of questions</th><th></th></tr></thead><tbody>
@foreach (var rule in Model)
{
    <tr><td>@rule.DifficultyLevel</td><td>@rule.NoOfQuestions</td><td><a asp-action="Edit" asp-route-id="@rule.Id">Edit</a></td></tr>
}
</tbody></table>
<p>Total: @total / @definition.NumberOfQuestions questions.
@if (definition.NumberOfQuestions > 0 && total == definition.NumberOfQuestions) { <span>Complete</span> }
else { <span class="text-danger">Incomplete: rule counts must equal the section total before the exam can start.</span> }
</p>
<a asp-controller="ExamSections" asp-action="Edit" asp-route-id="@definition.Id">Edit section</a> |
<a asp-controller="ExamSections" asp-action="Index" asp-route-examId="@definition.ExamId">Back to sections</a>
