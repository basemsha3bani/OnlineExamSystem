@model List<DataModel.ExamSectionsDataModel>
@foreach (var definition in Model)
{
    <div>@definition.SectionName - @definition.NumberOfQuestions questions
        <a asp-controller="ExamSections" asp-action="Edit" asp-route-id="@definition.Id">Edit</a>
        <a asp-controller="ExamSectionRules" asp-action="Index" asp-route-sectionId="@definition.Id">Rules</a>
    </div>
}
