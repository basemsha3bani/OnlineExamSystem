@model DataModel.ExamSectionsDataModel
<h3>Create Section</h3>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input asp-for="ExamId" type="hidden" />
    <div class="mb-3"><label asp-for="SectionName" class="form-label">Section name</label><input asp-for="SectionName" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Save section</button>
</form>
<a asp-action="Index" asp-route-examId="@Model.ExamId">Back to sections</a>
