@using DataModel
@model ExamDataModel

<h2>@Model.Title</h2>
<p><b>Subject:</b> @Model.StudySubjectName</p>
<div id="sections-container">
    @await Html.PartialAsync("~/Views/ExamSections/_List.cshtml", Model.Sections)
</div>
<button type="button" id="btnAddSection" class="btn btn-secondary"
        data-url="@Url.Action("Create", "ExamSections", new { examId = Model.Id })">Add Section</button>
<div id="section-error" class="text-danger" role="alert"></div>
<div id="section-form-container"></div>

@section Scripts {
    <script src="~/js/exam-details.js" asp-append-version="true"></script>
}
