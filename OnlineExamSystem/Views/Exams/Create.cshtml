@model DataModel.ExamDataModel
<h3>Create Exam</h3>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Title" class="form-label">Exam name</label><input asp-for="Title" class="form-control" /></div>
    <div class="mb-3"><label asp-for="StudySubjectId" class="form-label">Subject</label><select asp-for="StudySubjectId" asp-items="ViewBag.Subjects" class="form-control"><option value="">Select subject</option></select></div>
    <button class="btn btn-primary" type="submit">Save exam</button>
    <a asp-action="Index">Back to exams</a>
</form>
