@using Domain.DTOs
@model List<ExamDTO>
<a asp-action="Create" class="btn btn-primary">Add Exam</a>
<table class="table">
    <tr><th>Title</th><th>Subject</th><th>Actions</th></tr>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Title <a asp-controller="ExamSections" asp-action="Index" asp-route-examId="@e.Id">Sections</a></td>
            <td>@e.StudySubjectName</td>
            <td>
                <a asp-controller="ExamSections" asp-action="Create" asp-route-examId="@e.Id">Add section</a>
            </td>
        </tr>
    }
</table>