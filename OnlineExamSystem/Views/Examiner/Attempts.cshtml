@model List<DataModel.ExamAttemptDataModel>
@{ ViewData["Title"] = "Attempt status"; }
<h1>Attempt status</h1>
<p>You do not need to wait here. Return at any time to view completed results.</p>
<p><a class="btn btn-outline-primary" asp-action="Attempts">Refresh status</a> <a asp-action="Index">Take an exam</a></p>
@if (Model.Count == 0) { <p>You have no exam attempts yet.</p> }
else
{
    <div class="table-responsive"><table class="table">
        <thead><tr><th>Exam</th><th>Submitted (UTC)</th><th>Status</th><th>Result</th></tr></thead>
        <tbody>
        @foreach (var attempt in Model)
        {
            <tr>
                <td>@attempt.ExamTitle</td>
                <td>@(attempt.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                <td>@(attempt.Status == "Scored" ? "Evaluation completed" : attempt.Status == "Submitted" ? "Under evaluation" : "In progress")</td>
                <td>
                    @if (attempt.Status == "Scored") { <a asp-action="Result" asp-route-id="@attempt.Id">View result</a> }
                    else if (attempt.Status == "InProgress") { <a asp-action="Take" asp-route-id="@attempt.Id">Resume exam</a> }
                    else { <span>Processing</span> }
                </td>
            </tr>
        }
        </tbody>
    </table></div>
}
